{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Muss mit dem Worker-Namen im Cloudflare-Dashboard übereinstimmen, sonst bricht der Build ab.
  "name": "waldbrand-uav-rechner",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-13",
  // Wird bei jedem Build aus calc/ erzeugt (npm run build), nicht von Hand bearbeiten.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Liste der Teammodelle (Tabelle models; der Worker legt sie bei Bedarf selbst an)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uav-budget",
      "database_id": "c0b9cedc-0844-48e0-839f-a9de39cd6cce"
    }
  ],
  // Jedes Teammodell ist ein Durable Object mit eigener SQLite-Datenbank (Dokument, Verlauf, Stände)
  // und den WebSocket-Verbindungen aller, die es offen haben.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "ModelRoom" }]
  },
  // Klasse einmalig mit SQLite-Speicher anlegen (im Free-Plan nur so möglich). Einträge hier nie ändern oder
  // löschen, sondern für spätere Änderungen neue Einträge mit neuem tag anhängen.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ModelRoom"] }],
  "observability": { "enabled": true }
}
